                  "endLine": 3881,
                  "endColumn": 34,
                  "charOffset": 130729,
                  "charLength": 98,
                  "snippet": {
                    "text": "strncpy((char *)result->EvalData.stringVal, strLiteral.c_str(),\n                strLiteral.size())",
                    "rendered": {
                      "text": "strncpy((char *)result->EvalData.stringVal, strLiteral.c_str(),\n                strLiteral.size())",
                      "markdown": "`strncpy((char *)result->EvalData.stringVal, strLiteral.c_str(),\n                strLiteral.size())`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "strncpy is dangerous, as if the source contains 'n' or more characters, it will not null terminate the destination."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "tools/libclang/CIndex.cpp"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "charOffset": 130729,
                        "charLength": 98
                      },
                      "insertedContent": {
                        "text": "strcpy_s((char *)result->EvalData.stringVal, \n                strLiteral.size(,  strLiteral.c_str())"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "description": {
                "text": "strncpy is dangerous, as if the source contains 'n' or more characters, it will not null terminate the destination."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "tools/libclang/CIndex.cpp"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "charOffset": 130729,
                        "charLength": 98
                      },
                      "insertedContent": {
                        "text": "strlcpy((char *)result->EvalData.stringVal,  strLiteral.c_str(), \n                strLiteral.size()"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "DevSkimSeverity": "Important",
